@charset "UTF-8"; 

#container {
    width:100%;
    font-size:11px;
    line-height: 20px;
}
#container table {
    width:100%;
    border-collapse: collapse;
    font-size:11px;
    line-height: 20px;
}
#container th {
    padding: 3px;
    border: #BDD8E2 solid 1px;
    background: #E2F0F6;
    color: #02a1c7;
}
#container td {
    padding: 3px;
    border:#BDD8E2 solid 1px;
    background: #ffffff;
    color: #777777;
}

/** ��씠��**/
.title_main {
    clear: both;
    width: 100%;
    color: #09A6C7;
    height:25px;
    padding-bottom:3px; 
    padding-top:1px;
    font-size:14pt;
    font-weight: bold;
    padding-left: 17px;
    text-align: left;
    background-image: url('/isms/image/icon/titleicon1_5.gif');
    background-repeat:no-repeat;
}

.centertxt {text-align:center;}
.righttxt {text-align:right; padding: 5px;}
.lefttxt {text-align:left;}

excel_table {
    width:100%;
    border-collapse: collapse;
    font-size:11px;
    line-height: 20px;
}

.excel_th  {
    padding: 3px;
    border: #BDD8E2 solid 1px;
    background: #E2F0F6;
    color: #02a1c7;
    text-align: center;
}

.excel_th_left  {
    padding: 3px;
    border: #BDD8E2 solid 1px;
    background: #E2F0F6;
    color: #02a1c7;
    text-align: left;
    padding-left:10px;
}
.excel_th_right  {
    padding: 3px;
    border: #BDD8E2 solid 1px;
    background: #E2F0F6;
    color: #02a1c7;
    text-align: left;
    padding-right:10px;
}
.excel_td  {
    padding: 3px;
    border:#BDD8E2 solid 1px;
    background: #ffffff;
    color: #777777;
    text-align: center;
}
.excel_td_left  {
    padding: 3px;
    border:#BDD8E2 solid 1px;
    background: #ffffff;
    color: #777777;
    text-align: left;
    padding-left:10px;
}
.excel_td_right  {
    padding: 3px;
    border:#BDD8E2 solid 1px;
    background: #ffffff;
    color: #777777;
    text-align: right;
    padding-right:10px;
}
.excel2_th  {
    padding: 3px;
    border: #676767 solid 1px;
    text-align: center;
}

.excel2_td  {
    padding: 3px;
    border: #676767 solid 1px;
    text-align: center;
