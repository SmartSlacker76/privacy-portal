/* 2014.05.26 */
/* @charset "utf-8"; */
/* 기존 base.css 를 기준으로 합니다. */

/* 팝업 */
#popup-wrap{border-top:3px solid #2089b1; position:relative; overflow:hidden; background:url(/images/lvc/popup_bg.jpg) left top no-repeat}
#popup-wrap .popup-content{padding:0px 20px; padding-top:60px}
.popup-btn{position:relative; width:678px;}

/* 최정낙 */
.shine:hover{text-decoration:underline; color:#1ea2d8}
#contrain h2.contrain_title{font-size:13px; display:inline}
#contrain table.hborder thead th{border:1px solid #e3e3e3}
#contrain .m_on{font-weight:bold}
#contrain .m_off{font-weight:normal}
.arrh{margin-right:5px; position:relative; top:2px}
#default_page{border-top:2px solid #1ea2d8; border-bottom:1px solid #e3e3e3; padding:25px 0; text-align:center; margin:3px 0;}

.test_title{margin-bottom:10px}
.test_title thead th{background:#dddddd; height:27px; border-right:1px solid #fff;}
.test_title thead th.last{border:0}

.test_content tbody td{text-align:center}
.test_content tbody td.left{text-indent:10px; text-align:left}
.test_content tbody td.title{height:40px; color:#fff; background:#3a6aae; font-weight:bold}
.test_content tbody td.subtitle{color:#3a6aae; border-bottom:1px solid #bcc7d6; height:34px; background:#f3f5f7; font-weight:bold}
.test_content tbody td.subtitle_s{border-bottom:1px solid #bcc7d6; height:34px; background:#f3f5f7;}
.test_content tbody td.text{height:50px; border-bottom:1px solid #dadada;}
.test_content tbody td.sborder{border-left:1px solid #fff; border-right:1px solid #fff}
.test_content tbody td.sborder2{border-left:1px solid #e7e4ed; border-right:1px solid #e7e4ed}
.test_content tbody td.sborder3{border-left:1px solid #e7e4ed;}

.test_content tbody td.comment{background:#fafafa; padding:8px 0; border-bottom:1px solid #dadada; text-align:left; line-height:40px; height:40px; vertical-align:middle;}
.test_content tbody td.tr10{padding-right:40px}
.test_content tbody td.comment_title{background:#fafafa; padding:8px 0; border-bottom:1px solid #dadada; text-align:left; line-height:28px; vertical-align:top; font-weight:bold; font-size:11px}

.gtab{height:25px}
.gtab li{margin-right:5px}

.select_80c{width:80px; height:18px; border:1px solid #DFE6EE; background:#F4F8F9; color:#444; padding:0 1px 0 3px; margin:2px 2px 2px 0; font-size: 12px; font-family: 돋움; margin:0 15px; text-align:center}

#default_pb{border:3px solid #efefef; height:185px; position:relative; overflow:hidden; margin-top:10px}
#default_pb .jb_visual{position:absolute; left:36px; top:25px}
#default_pb .pb_text{position:absolute; left:265px; top:40px; line-height:20px}

.filetable{border-top:2px solid #1fa2d8; border-bottom:1px solid #f3f3f3; margin-top:30px}
.filetable tbody th{background:#f8f8f8; border-left:1px solid #e4e4e4; border-right:1px solid #e4e4e4; padding:7px 0; vertical-align:top; text-align:left; padding-left:10px}
.filetable tbody td{color:#5f7cc8; padding:8px 0; padding-left:10px; line-height:20px;}
.filetable tbody td p{background:url(/images/lvc/bluedot.gif) left center no-repeat; padding-left:10px}

.com_text{width:700px; height:50px; margin-bottom:5px;}
.com_text2{width:700px; min-height:50px; margin-bottom:5px; float:left; text-indent:0; font-weight:normal; padding-left:10px}

.contrain table{border-collapse:collapse}
.test_content{border-collapse:collapse}


#contship{width:100%; font-size:12px; margin:0 0 10px 0; line-height:20px;}
#contship table {border-width:0; font:12px; border-collapse: collapse; text-align:center;}
#contship th {height:35px; font-weight:bold; border:none; color:#3a6aae; text-align:center; background:url(/images/bg/contship_md.gif) repeat-x 0 0; color:#3a6aae; border-top:1px solid #bcc7d6; border-bottom:1px solid #bcc7d6; height:34px; background:#f3f5f7; font-weight:bold}
#contship th.tp{background:url(/images/bg/contship_tp.gif) no-repeat 0 0; border:none;}
#contship th.btm{background:url(/images/bg/contship_btm.gif) no-repeat 100% 0; border:none;}
#contship td {border-width:0; height:26px; border-bottom:1px solid #dadada; border-left:none; border-right:none; text-align:center;}
#contship .left{text-align:left; padding-left:10px;}
#contship .right{text-align:right; padding-left:10px;}
#contship .date{margin-bottom:-2px}
    br { mso-data-placement:same-cell; }
</style>
